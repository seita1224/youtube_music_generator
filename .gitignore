# --- Secrets (ADR-0012, ADR-0013) ---
.env
.env.local
.env.*.local
*.pem
*.key
!FERNET_KEY.example

# --- Runtime data / generated artifacts (ADR-0026) ---
data/
backups/
/srv/ymg/

# --- Python ---
**/__pycache__/
**/*.py[cod]
**/.venv/
.venv/
**/.mypy_cache/
**/.ruff_cache/
**/.pytest_cache/
**/htmlcov/
**/.coverage
**/coverage.xml

# uv: lockfiles ARE committed (do not ignore)
!**/uv.lock

# --- Node / Next.js ---
**/node_modules/
**/.next/
**/out/
**/dist/
**/build/
**/*.tsbuildinfo
**/.turbo/

# --- Frontend test artifacts ---
**/coverage/
**/test-results/
**/playwright-report/
**/.playwright/

# --- Next.js 自動生成 ---
frontend/next-env.d.ts

# --- Generated API types (regenerated from contracts) ---
frontend/lib/api/schema.ts

