# YouTube 音楽投稿自動化システム — 環境変数テンプレート
# 使い方: cp .env.example .env してから値を埋める。 .env は .gitignore で除外される。
# 出典: specs/001-youtube-music-generator/quickstart.md §3
#       + specs/002-slot-centric-redesign/quickstart.md §1(枠中心モデルの差分)

# --- データ / ストレージ ---
DATA_ROOT=/srv/ymg                          # 動画/音楽/サムネ/モデル重みのルート
BACKUP_ROOT=/mnt/backup/ymg                 # ADR-0026 セカンダリディスク
STORAGE_BASE_URI=file:///srv/ymg/outputs    # fsspec 抽象 (ADR-0022)。 file:// / s3:// / gs://

# --- PostgreSQL ---
POSTGRES_HOST=postgres                      # コンテナ間は service 名。 host から alembic 実行時は localhost
POSTGRES_PORT=5432                           # コンテナ内部ポート
POSTGRES_HOST_PORT=5432                      # ホスト公開ポート。 他プロジェクトの 5432 と衝突する場合は変更(例 5433)
FRONTEND_HOST_PORT=3000                      # frontend のホスト公開ポート。 ポート占有/Docker Desktop の転送 stuck 時は変更(例 3001)
POSTGRES_DB=ymg
POSTGRES_TEST_DB=ymg_test                    # integration テスト専用 DB(未設定なら <POSTGRES_DB>_test)。 dev DB 保護のため別 DB を使う
POSTGRES_USER=ymg
POSTGRES_PASSWORD=                          # __set_strong_value__

# --- Fernet 暗号鍵 (ADR-0012) — バックアップ対象外、 DB ダンプと別ディスクに保管 ---
# 生成: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=                                 # __base64_44_chars__

# --- 管理 UI 認証 (ADR-0013) ---
# backend は HTTP Basic(LAN 直叩き用)。 frontend は /login + 署名付きセッション cookie。
# NEXT_PUBLIC_* に資格情報を置かないこと。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=                             # __set_strong_value__ (空は backend 起動拒否)
# セッション HMAC 鍵(サーバ専用、UTF-8 32 バイト以上)。 生成例: openssl rand -base64 48
AUTH_SESSION_SECRET=                        # __set_strong_value__
# LAN HTTP では false。 HTTPS 終端時のみ true。
AUTH_COOKIE_SECURE=false

# --- LLM Provider (ADR-0019) ---
LLM_PROVIDER=ollama                         # openai / anthropic / ollama
LLM_AUTH_MODE=api_key                       # api_key のみ正式サポート。 codex_oauth は未配線 (PUT 422)
OPENAI_API_KEY=                             # 非空なら SoT (UI 入力不可)。空なら管理 UI から DB 暗号化保存可
ANTHROPIC_API_KEY=                          # 同上
OLLAMA_BASE_URL=http://localhost:11434

# --- YouTube (ADR-0021) ---
YOUTUBE_CLIENT_ID=                          # __google_cloud_oauth_id__
YOUTUBE_CLIENT_SECRET=                      # __google_cloud_oauth_secret__
YOUTUBE_REDIRECT_URI=http://localhost:8000/auth/youtube/callback
YOUTUBE_CHANNEL_ID=                         # UC...

# --- AcoustID (ADR-0005) ---
ACOUSTID_API_KEY=                           # __from_acoustid_org__

# --- Slack (ADR-0043 / ADR-0044) ---
SLACK_WEBHOOK_URL=                          # 単純通知用 https://hooks.slack.com/services/...
SLACK_BOT_TOKEN=                            # xoxb-... ボタン付き通知 (chat.postMessage + Block Kit)
SLACK_APP_TOKEN=                            # xapp-... Socket Mode (connections:write scope)

# --- GPU worker (ADR-0031) — クラウド移行時はこの URL を差し替えるだけ ---
GPU_WORKER_BASE_URL=http://127.0.0.1:8001

# --- 運用 (ADR-0044 / ADR-0045) ---
# 停止は 2 段階のシステム状態 (running / publish_paused / stopped) で表現する。
# dryrun / scheduler 手動 enable は廃止 (ADR-0042 / ADR-0044)。
PUBLISH_WARN_PER_DAY=6                      # 編成表の 1 日公開予定の警告閾値 (research.md R-1)
YMG_ADMIN_TOKEN=                            # __set_strong_value__ CLI / Slack 受信系が system API を呼ぶ管理トークン
MONTHLY_BUDGET_USD=50                       # LLM 月次予算 (usage_log 集計)
LOG_LEVEL=INFO

# --- 旧システムからの移行 (ADR-0050, `ymg migrate-legacy` 実行時のみ) ---
LEGACY_DATABASE_URL=                        # postgresql://... 旧 DB への読み取り専用接続
